<service>
  <id>POSAguacates</id>
  <name>POS Aguacates</name>
  <description>Servidor local de la instalación original de POS Aguacates</description>
  <executable>C:\Program Files\nodejs\node.exe</executable>
  <arguments>index.js</arguments>
  <workingdirectory>C:\posaguacates\pos-backend</workingdirectory>
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <onfailure action="restart" delay="5 sec"/>
  <logpath>C:\posaguacates\pos-backend\logs</logpath>
  <log mode="roll-by-size"><sizeThreshold>10240</sizeThreshold><keepFiles>8</keepFiles></log>
</service>
