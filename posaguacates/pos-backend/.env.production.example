# Copie este archivo como .env en la computadora de la empresa.
# No escriba contraseñas reales en este archivo versionado.
NODE_ENV=production

# IA generativa opcional (la clave solo debe existir en el servidor)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_MS=20000
PORT=3000
HOST=127.0.0.1

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=pos_app
DB_PASSWORD=CHANGE_ME_WITH_A_UNIQUE_PASSWORD
DB_NAME=posaguacates
DB_CONNECT_RETRIES=60
DB_CONNECT_RETRY_MS=2000

JWT_SECRET=GENERATE_A_RANDOM_SECRET_BEFORE_STARTING
JWT_EXPIRES_IN=8h
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

ALLOW_DESTRUCTIVE_TEST_DELETES=false

# Respaldo y traslado. INSTANCE_ID vacío se genera una sola vez en pos-backend/data/instance-id.
INSTANCE_ID=
BACKUP_MAX_SIZE_MB=500
BACKUP_DIR=C:\posaguacates\backups
MARIADB_BIN_DIR=C:\Program Files\MariaDB 12.3\bin
BACKUP_RETENTION_COUNT=30
PRE_RESTORE_RETENTION_COUNT=10
BACKUP_ANALYSIS_TOKEN_TTL_MS=600000
